# Exception: sitemap.xml and robots.txt (to PinSSG)
/sitemap.xml  https://pinssg.netlify.app/sitemap.xml  200!
/robots.txt  https://pinssg.netlify.app/robots.txt  200!

# Critical: _astro static assets to Guidebook SSG (prevent 404 errors)
/_astro/*  https://moonlit-buttercream-29b4f6.netlify.app/_astro/:splat  200!

# Guidebook SSG routes (all /en/guidebook and /zh/guidebook paths)
/en/guidebook/*  https://moonlit-buttercream-29b4f6.netlify.app/en/guidebook/:splat  200!
/en/guidebook  https://moonlit-buttercream-29b4f6.netlify.app/en/guidebook  200!
/zh/guidebook/*  https://moonlit-buttercream-29b4f6.netlify.app/zh/guidebook/:splat  200!
/zh/guidebook  https://moonlit-buttercream-29b4f6.netlify.app/zh/guidebook  200!

# Pin SSG routes (all /en/spot and /zh/spot paths)
/en/spot/*  https://pinssg.netlify.app/en/spot/:splat  200!
/zh/spot/*  https://pinssg.netlify.app/zh/spot/:splat  200!

# MOP PWA static assets (served from this deployment - highest priority)
/assets/*  /assets/:splat  200
/sw.js  /sw.js  200
/workbox-*.js  /workbox-:splat.js  200
/*.png  /:splat.png  200
/*.svg  /:splat.svg  200
/*.ico  /:splat.ico  200
/*.json  /:splat.json  200

# SPA fallback for MOP PWA routes
/en  /index.html  200
/zh  /index.html  200
